{"markdown":{"yaml":{"pagetitle":"Mack White | Aquatic Ecologist","page-layout":"custom","toc":false,"section-divs":false},"containsRefs":false,"markdown":"\n\n```{=html}\n<script>document.body.classList.add('mw-home');</script>\n\n<!-- ============ HERO: drone video ============ -->\n<!-- Hero video: media/smallmouth-buffalo-drone.mp4 (32 s loop from the April 2019 drone flight).\n     The poster is its first frame, shown while the video loads.\n -->\n<header class=\"mw-hero\">\n  <video class=\"mw-hero-video\" autoplay muted loop playsinline preload=\"metadata\"\n         poster=\"media/smallmouth-buffalo-poster.jpg\" aria-hidden=\"true\">\n    <source src=\"media/smallmouth-buffalo-drone.mp4\" type=\"video/mp4\">\n  </video>\n  <div class=\"mw-hero-shade\"></div>\n  <div class=\"mw-hero-text\">\n    <h1 class=\"mw-name\">Mack<br>White</h1>\n    <p class=\"mw-role\">Aquatic ecologist. Postdoctoral Research Scientist at The Ohio State University.</p>\n    <nav class=\"mw-hero-links\" aria-label=\"Quick links\">\n      <a href=\"Research.html\">Research</a>\n      <a href=\"CV.html\">CV</a>\n      <a href=\"mailto:mackwhiteecology@gmail.com\">Email me</a>\n    </nav>\n  </div>\n  <div class=\"mw-hero-foot\">\n    <p class=\"mw-hero-caption\">Smallmouth Buffalo spawning migration in Citico Creek. Drone footage by Mack White.</p>\n    <button class=\"mw-video-toggle\" type=\"button\" aria-pressed=\"false\">Pause video</button>\n  </div>\n</header>\n\n<!-- ============ INTRO ============ -->\n<section class=\"mw-intro\">\n  <p class=\"mw-lede\">What are the ecological causes and consequences of animal behaviors like movement and foraging? <span class=\"mw-lede-sub\">My research asks how global change reshapes these behaviors, and what that means for populations, communities, and the flow of nutrients and energy through ecosystems.</span></p>\n  <div class=\"mw-intro-side\">\n    <img src=\"images/web/fish-viewer-sm.jpg\" alt=\"Mack White holding a clear viewer full of small stream fish\" class=\"mw-portrait\">\n    <p>I work with Dr. Casey Pennock in the Aquatic Conservation &amp; Ecology Lab at Ohio State, mostly in rivers of the Colorado River and Ohio River basins. Before that I earned my Ph.D. at Florida International University working in Everglades National Park.</p>\n    <p class=\"mw-links\">\n      <a href=\"https://scholar.google.com/citations?user=hLHcmSYAAAAJ&amp;hl=en&amp;oi=sra\">Google Scholar</a>\n      <a href=\"https://github.com/mackwhite\">GitHub</a>\n      <a href=\"https://bsky.app/profile/mackeco.bsky.social\">Bluesky</a>\n    </p>\n  </div>\n</section>\n\n<!-- ============ FULL-BLEED PHOTO ============ -->\n<figure class=\"mw-band\">\n  <img src=\"images/web/ridge-panorama.jpg\" alt=\"Forested ridgelines fading into cloud\" loading=\"lazy\">\n</figure>\n\n<!-- ============ RESEARCH THEMES ============ -->\n<section class=\"mw-research\" aria-labelledby=\"research-h\">\n  <h2 id=\"research-h\" class=\"mw-h2\">What I work on</h2>\n  <div class=\"mw-themes\">\n    <article class=\"mw-theme\">\n      <img src=\"images/web/fiu-snook-sm.jpg\" alt=\"Mack holding a Common Snook on a boat\" loading=\"lazy\">\n      <h3>Animal movement</h3>\n      <p>I use a variety of techniques to understand the ecological causes and consequences of animal movement, from Common Snook in the Gulf of Mexico to suckers in Appalachian streams.</p>\n    </article>\n    <article class=\"mw-theme\">\n      <img src=\"images/web/ttu-sucker-smile-sm.jpg\" alt=\"Mack standing in a stream holding a sucker\" loading=\"lazy\">\n      <h3>Nutrients and food webs</h3>\n      <p>From lakes to rivers and rivers to coral reefs, animals link seemingly disparate ecosystems by recycling nutrients and moving energy.</p>\n    </article>\n    <article class=\"mw-theme\">\n      <img src=\"images/web/osu-boat-sm.jpg\" alt=\"Mack lifting a large fish into a sampling boat on a muddy river\" loading=\"lazy\">\n      <h3>Rivers under global change</h3>\n      <p>How flow loss, warming, and invasive species reshape native fish and aquatic insect communities in the Colorado River and Ohio River basins.</p>\n    </article>\n  </div>\n  <p class=\"mw-more\"><a href=\"CV.html#publications\">See publications</a></p>\n</section>\n\n<!-- ============ FIELD GALLERY ============ -->\n<!-- Edit captions in the data-caption attributes. g-wide = big, g-tall = portrait, g-std = small -->\n<section class=\"mw-gallery-wrap\" aria-labelledby=\"field-h\">\n  <h2 id=\"field-h\" class=\"mw-h2 mw-pad\">From the field</h2>\n  <div class=\"mw-gallery\">\n    <button class=\"g-wide\" data-full=\"images/web/ttu-transect.jpg\" data-caption=\"Good friend and technician, Ryan Hudson, measuring discharge in Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-transect-sm.jpg\" alt=\"Ryan Hudson wading across a stream with a measuring rod\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-boat-wake.jpg\" data-caption=\"Running in Florida Bay, Everglades National Park on a sunny day\"><img src=\"images/web/fiu-boat-wake-sm.jpg\" alt=\"Mack driving a boat with a long white wake behind\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-flathead.jpg\" data-caption=\"Big, beautiful Flathead Catfish in the Muskingum River, OH\"><img src=\"images/web/ors-flathead-sm.jpg\" alt=\"Mack holding a Flathead Catfish on an electrofishing boat\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-cowfish.jpg\" data-caption=\"The cutest cowfish ever sampled in the Gulf of Mexico\"><img src=\"images/web/fiu-cowfish-sm.jpg\" alt=\"A small spotted cowfish held between two fingers\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/ttu-sucker-bank.jpg\" data-caption=\"Migrant Smallmouth Buffalo sampled from Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-sucker-bank-sm.jpg\" alt=\"Mack holding a Smallmouth Buffalo beside a stream\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-red-hats.jpg\" data-caption=\"The sampling team ready to track down the Jaguar Shark with Steve Zissou (watch The Life Aquatic if you haven’t)\"><img src=\"images/web/fiu-red-hats-sm.jpg\" alt=\"Four people in matching red beanies by a mangrove creek\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/osu-canyon.jpg\" data-caption=\"The mighty Colorado River near Moab, UT\"><img src=\"images/web/osu-canyon-sm.jpg\" alt=\"The Colorado River running between red rock canyon walls\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/osu-blue-catfish.jpg\" data-caption=\"Big Blue Catfish from the Scioto River, OH\"><img src=\"images/web/osu-blue-catfish-sm.jpg\" alt=\"Mack holding a large Blue Catfish on an electrofishing boat\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/osu-sucker-lips.jpg\" data-caption=\"Pucker up – papillose lips on a Blue Sucker sampled in the Little Miami River, OH\"><img src=\"images/web/osu-sucker-lips-sm.jpg\" alt=\"Close-up of the bumpy, fleshy lips of a Blue Sucker\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/osu-wake.jpg\" data-caption=\"Little boat, big river – mainstem Ohio River\"><img src=\"images/web/osu-wake-sm.jpg\" alt=\"Selfie on a boat with the wake and river behind\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-release.jpg\" data-caption=\"Flushing water across the gills of a Bull Shark during acoustic tagging in Florida Bay, Everglades National Park\"><img src=\"images/web/fiu-release-sm.jpg\" alt=\"Leaning over a boat to release a fish at sunset\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-backpack.jpg\" data-caption=\"Ghostbuster or aquatic scientist? Backpack electrofishing a small stream in upstate New York\"><img src=\"images/web/ors-backpack-sm.jpg\" alt=\"Backpack electrofishing in a narrow stream\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-blue-crab.jpg\" data-caption=\"Blue Crab collected for stable isotopes in the Shark River, Everglades National Park\"><img src=\"images/web/fiu-blue-crab-sm.jpg\" alt=\"Holding up a blue crab by its claws on a boat\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/ttu-larvae.jpg\" data-caption=\"Larval suckers from Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-larvae-sm.jpg\" alt=\"Three larval suckers seen through a microscope eyepiece\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-gar-night.jpg\" data-caption=\"Do you know why they call it a Longnose Gar? Ohio River near Paducah, KY\"><img src=\"images/web/ors-gar-night-sm.jpg\" alt=\"Mack holding a Longnose Gar at night under a headlamp\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-crocodile.jpg\" data-caption=\"An American Crocodile with a meal at the Flamingo boat ramp\"><img src=\"images/web/fiu-crocodile-sm.jpg\" alt=\"A crocodile holding prey in its jaws at the edge of a boat ramp\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-snook-workup.jpg\" data-caption=\"Acoustic tagging surgery on a Common Snook in Tarpon Bay, Everglades National Park\"><img src=\"images/web/fiu-snook-workup-sm.jpg\" alt=\"Handling a snook in a tub on an electrofishing boat\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ttu-crew.jpg\" data-caption=\"Sucker squad – great team of students and friends that made my MS work possible\"><img src=\"images/web/ttu-crew-sm.jpg\" alt=\"Four people in waders beside a stream\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-lily-sampling.jpg\" data-caption=\"Sampling the base of the food web in the marsh-mangrove ecotone of the Shark River, Everglades National Park\"><img src=\"images/web/fiu-lily-sampling-sm.jpg\" alt=\"Mack chest-deep in water among lily pads, handing samples to a colleague\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/tu-saw-crew.jpg\" data-caption=\"Stream restoration crew in Monongahela National Forest, WV\"><img src=\"images/web/tu-saw-crew-sm.jpg\" alt=\"Three crew members with chainsaws in the forest\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-shark.jpg\" data-caption=\"A Bull Shark, measured and sampled for stable isotopes in Florida Bay, Everglades National Park\"><img src=\"images/web/fiu-shark-sm.jpg\" alt=\"Mack kneeling on a boat with a shark\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/osu-catfish-selfie.jpg\" data-caption=\"The cutest kitty on the river – Great Miami River, OH\"><img src=\"images/web/osu-catfish-selfie-sm.jpg\" alt=\"Mack grinning beside a catfish held up to the camera\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/osu-redhorse.jpg\" data-caption=\"Blue Sucker, one of my favorites, in the Scioto River, OH\"><img src=\"images/web/osu-redhorse-sm.jpg\" alt=\"Mack holding a large Blue Sucker beside a river\" loading=\"lazy\" style=\"object-position: 75% 50%\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/osu-gravel-bar.jpg\" data-caption=\"Lunch break on the Scioto River, OH\"><img src=\"images/web/osu-gravel-bar-sm.jpg\" alt=\"View from a boat of a wide muddy river beside a gravel bar\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-seine.jpg\" data-caption=\"Retrieving a seine set from Florida Bay, Everglades National Park\"><img src=\"images/web/fiu-seine-sm.jpg\" alt=\"Crew pulling a seine net with red floats into a boat on open water\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-boat.jpg\" data-caption=\"Winter workin’ on the Ohio River\"><img src=\"images/web/ors-boat-sm.jpg\" alt=\"Driving a sampling boat on a river\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-camp-night.jpg\" data-caption=\"Late nights at Canepatch, a shell midden deep in the Shark River backcountry of Everglades National Park\"><img src=\"images/web/fiu-camp-night-sm.jpg\" alt=\"Tents glowing under headlamps at night\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-snook-release2.jpg\" data-caption=\"Releasing a tagged Common Snook in the Shark River, Everglades National Park\"><img src=\"images/web/fiu-snook-release2-sm.jpg\" alt=\"Reaching over the side of a boat to release a snook\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ttu-sucker-smile.jpg\" data-caption=\"A fish-filled day on Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-sucker-smile-sm.jpg\" alt=\"Grinning in a stream with a sucker\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-forest-crew.jpg\" data-caption=\"Survey crew in a pristine headwater stream somewhere in Pennsylvania\"><img src=\"images/web/ors-forest-crew-sm.jpg\" alt=\"A survey crew sitting on a log over a rocky stream\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ttu-overlook.jpg\" data-caption=\"Taking a break from sucker sampling to dig for ramps along the Tennessee-North Carolina line\"><img src=\"images/web/ttu-overlook-sm.jpg\" alt=\"Standing on a grassy overlook above forested hills\" loading=\"lazy\"></button>\n  </div>\n</section>\n\n<dialog class=\"mw-lightbox\" aria-label=\"Photo viewer\">\n  <img alt=\"\">\n  <p class=\"mw-lb-caption\"></p>\n  <button class=\"mw-lb-close\" type=\"button\">Close</button>\n  <button class=\"mw-lb-prev\" type=\"button\" aria-label=\"Previous photo\">&#8249;</button>\n  <button class=\"mw-lb-next\" type=\"button\" aria-label=\"Next photo\">&#8250;</button>\n</dialog>\n\n<!-- ============ PATH ============ -->\n<section class=\"mw-path\" aria-labelledby=\"path-h\">\n  <h2 id=\"path-h\" class=\"mw-h2\">How I got here</h2>\n  <ol>\n    <li><span class=\"yr\">2025 to now</span><span><strong>The Ohio State University</strong>, Postdoctoral Research Scientist</span></li>\n    <li><span class=\"yr\">2021 to 2025</span><span><strong>Florida International University</strong>, Ph.D.</span></li>\n    <li><span class=\"yr\">2019 to 2021</span><span><strong>Tennessee Technological University</strong>, M.S.</span></li>\n    <li><span class=\"yr\">2018</span><span><strong>ORSANCO</strong>, Contractual Biologist</span></li>\n    <li><span class=\"yr\">2017</span><span><strong>Trout Unlimited &amp; US Forest Service</strong>, Watershed Restoration Technician</span></li>\n    <li><span class=\"yr\">2013 to 2017</span><span><strong>Marshall University</strong>, B.S.</span></li>\n  </ol>\n</section>\n\n<!-- ============ CONTACT ============ -->\n<section class=\"mw-contact\">\n  <p>Want to collaborate or have questions?</p>\n  <a class=\"mw-contact-mail\" href=\"mailto:mackwhiteecology@gmail.com\">mackwhiteecology@gmail.com</a>\n</section>\n\n<script>\n(function () {\n  // Hero video: pause control, and respect reduced-motion settings\n  var v = document.querySelector('.mw-hero-video');\n  var btn = document.querySelector('.mw-video-toggle');\n  function setPlaying(on) {\n    if (on) { v.play().catch(function(){}); } else { v.pause(); }\n    btn.textContent = on ? 'Pause video' : 'Play video';\n    btn.setAttribute('aria-pressed', on ? 'false' : 'true');\n  }\n  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); setPlaying(false); }\n  btn.addEventListener('click', function () { setPlaying(v.paused); });\n  // Hide the toggle if the video file isn't there yet\n  var foot = document.querySelector('.mw-hero-foot');\n  var src = v.querySelector('source');\n  if (src) src.addEventListener('error', function () { foot.hidden = true; });\n\n  // Navbar goes solid once you scroll past the hero\n  var hero = document.querySelector('.mw-hero');\n  function onScroll() { document.body.classList.toggle('mw-scrolled', window.scrollY > hero.offsetHeight - 80); }\n  window.addEventListener('scroll', onScroll, { passive: true }); onScroll();\n\n  // Lightbox\n  var items = Array.prototype.slice.call(document.querySelectorAll('.mw-gallery button'));\n  var dlg = document.querySelector('.mw-lightbox');\n  var img = dlg.querySelector('img'), cap = dlg.querySelector('.mw-lb-caption');\n  var idx = 0;\n  function show(i) {\n    idx = (i + items.length) % items.length;\n    var b = items[idx];\n    img.src = b.dataset.full; img.alt = b.querySelector('img').alt; cap.textContent = b.dataset.caption || '';\n  }\n  items.forEach(function (b, i) { b.addEventListener('click', function () { show(i); dlg.showModal(); }); });\n  dlg.querySelector('.mw-lb-close').addEventListener('click', function () { dlg.close(); });\n  dlg.querySelector('.mw-lb-prev').addEventListener('click', function () { show(idx - 1); });\n  dlg.querySelector('.mw-lb-next').addEventListener('click', function () { show(idx + 1); });\n  dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });\n  dlg.addEventListener('keydown', function (e) {\n    if (e.key === 'ArrowLeft') show(idx - 1);\n    if (e.key === 'ArrowRight') show(idx + 1);\n  });\n})();\n</script>\n```\n","srcMarkdownNoYaml":"\n\n```{=html}\n<script>document.body.classList.add('mw-home');</script>\n\n<!-- ============ HERO: drone video ============ -->\n<!-- Hero video: media/smallmouth-buffalo-drone.mp4 (32 s loop from the April 2019 drone flight).\n     The poster is its first frame, shown while the video loads.\n -->\n<header class=\"mw-hero\">\n  <video class=\"mw-hero-video\" autoplay muted loop playsinline preload=\"metadata\"\n         poster=\"media/smallmouth-buffalo-poster.jpg\" aria-hidden=\"true\">\n    <source src=\"media/smallmouth-buffalo-drone.mp4\" type=\"video/mp4\">\n  </video>\n  <div class=\"mw-hero-shade\"></div>\n  <div class=\"mw-hero-text\">\n    <h1 class=\"mw-name\">Mack<br>White</h1>\n    <p class=\"mw-role\">Aquatic ecologist. Postdoctoral Research Scientist at The Ohio State University.</p>\n    <nav class=\"mw-hero-links\" aria-label=\"Quick links\">\n      <a href=\"Research.html\">Research</a>\n      <a href=\"CV.html\">CV</a>\n      <a href=\"mailto:mackwhiteecology@gmail.com\">Email me</a>\n    </nav>\n  </div>\n  <div class=\"mw-hero-foot\">\n    <p class=\"mw-hero-caption\">Smallmouth Buffalo spawning migration in Citico Creek. Drone footage by Mack White.</p>\n    <button class=\"mw-video-toggle\" type=\"button\" aria-pressed=\"false\">Pause video</button>\n  </div>\n</header>\n\n<!-- ============ INTRO ============ -->\n<section class=\"mw-intro\">\n  <p class=\"mw-lede\">What are the ecological causes and consequences of animal behaviors like movement and foraging? <span class=\"mw-lede-sub\">My research asks how global change reshapes these behaviors, and what that means for populations, communities, and the flow of nutrients and energy through ecosystems.</span></p>\n  <div class=\"mw-intro-side\">\n    <img src=\"images/web/fish-viewer-sm.jpg\" alt=\"Mack White holding a clear viewer full of small stream fish\" class=\"mw-portrait\">\n    <p>I work with Dr. Casey Pennock in the Aquatic Conservation &amp; Ecology Lab at Ohio State, mostly in rivers of the Colorado River and Ohio River basins. Before that I earned my Ph.D. at Florida International University working in Everglades National Park.</p>\n    <p class=\"mw-links\">\n      <a href=\"https://scholar.google.com/citations?user=hLHcmSYAAAAJ&amp;hl=en&amp;oi=sra\">Google Scholar</a>\n      <a href=\"https://github.com/mackwhite\">GitHub</a>\n      <a href=\"https://bsky.app/profile/mackeco.bsky.social\">Bluesky</a>\n    </p>\n  </div>\n</section>\n\n<!-- ============ FULL-BLEED PHOTO ============ -->\n<figure class=\"mw-band\">\n  <img src=\"images/web/ridge-panorama.jpg\" alt=\"Forested ridgelines fading into cloud\" loading=\"lazy\">\n</figure>\n\n<!-- ============ RESEARCH THEMES ============ -->\n<section class=\"mw-research\" aria-labelledby=\"research-h\">\n  <h2 id=\"research-h\" class=\"mw-h2\">What I work on</h2>\n  <div class=\"mw-themes\">\n    <article class=\"mw-theme\">\n      <img src=\"images/web/fiu-snook-sm.jpg\" alt=\"Mack holding a Common Snook on a boat\" loading=\"lazy\">\n      <h3>Animal movement</h3>\n      <p>I use a variety of techniques to understand the ecological causes and consequences of animal movement, from Common Snook in the Gulf of Mexico to suckers in Appalachian streams.</p>\n    </article>\n    <article class=\"mw-theme\">\n      <img src=\"images/web/ttu-sucker-smile-sm.jpg\" alt=\"Mack standing in a stream holding a sucker\" loading=\"lazy\">\n      <h3>Nutrients and food webs</h3>\n      <p>From lakes to rivers and rivers to coral reefs, animals link seemingly disparate ecosystems by recycling nutrients and moving energy.</p>\n    </article>\n    <article class=\"mw-theme\">\n      <img src=\"images/web/osu-boat-sm.jpg\" alt=\"Mack lifting a large fish into a sampling boat on a muddy river\" loading=\"lazy\">\n      <h3>Rivers under global change</h3>\n      <p>How flow loss, warming, and invasive species reshape native fish and aquatic insect communities in the Colorado River and Ohio River basins.</p>\n    </article>\n  </div>\n  <p class=\"mw-more\"><a href=\"CV.html#publications\">See publications</a></p>\n</section>\n\n<!-- ============ FIELD GALLERY ============ -->\n<!-- Edit captions in the data-caption attributes. g-wide = big, g-tall = portrait, g-std = small -->\n<section class=\"mw-gallery-wrap\" aria-labelledby=\"field-h\">\n  <h2 id=\"field-h\" class=\"mw-h2 mw-pad\">From the field</h2>\n  <div class=\"mw-gallery\">\n    <button class=\"g-wide\" data-full=\"images/web/ttu-transect.jpg\" data-caption=\"Good friend and technician, Ryan Hudson, measuring discharge in Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-transect-sm.jpg\" alt=\"Ryan Hudson wading across a stream with a measuring rod\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-boat-wake.jpg\" data-caption=\"Running in Florida Bay, Everglades National Park on a sunny day\"><img src=\"images/web/fiu-boat-wake-sm.jpg\" alt=\"Mack driving a boat with a long white wake behind\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-flathead.jpg\" data-caption=\"Big, beautiful Flathead Catfish in the Muskingum River, OH\"><img src=\"images/web/ors-flathead-sm.jpg\" alt=\"Mack holding a Flathead Catfish on an electrofishing boat\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-cowfish.jpg\" data-caption=\"The cutest cowfish ever sampled in the Gulf of Mexico\"><img src=\"images/web/fiu-cowfish-sm.jpg\" alt=\"A small spotted cowfish held between two fingers\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/ttu-sucker-bank.jpg\" data-caption=\"Migrant Smallmouth Buffalo sampled from Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-sucker-bank-sm.jpg\" alt=\"Mack holding a Smallmouth Buffalo beside a stream\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-red-hats.jpg\" data-caption=\"The sampling team ready to track down the Jaguar Shark with Steve Zissou (watch The Life Aquatic if you haven’t)\"><img src=\"images/web/fiu-red-hats-sm.jpg\" alt=\"Four people in matching red beanies by a mangrove creek\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/osu-canyon.jpg\" data-caption=\"The mighty Colorado River near Moab, UT\"><img src=\"images/web/osu-canyon-sm.jpg\" alt=\"The Colorado River running between red rock canyon walls\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/osu-blue-catfish.jpg\" data-caption=\"Big Blue Catfish from the Scioto River, OH\"><img src=\"images/web/osu-blue-catfish-sm.jpg\" alt=\"Mack holding a large Blue Catfish on an electrofishing boat\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/osu-sucker-lips.jpg\" data-caption=\"Pucker up – papillose lips on a Blue Sucker sampled in the Little Miami River, OH\"><img src=\"images/web/osu-sucker-lips-sm.jpg\" alt=\"Close-up of the bumpy, fleshy lips of a Blue Sucker\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/osu-wake.jpg\" data-caption=\"Little boat, big river – mainstem Ohio River\"><img src=\"images/web/osu-wake-sm.jpg\" alt=\"Selfie on a boat with the wake and river behind\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-release.jpg\" data-caption=\"Flushing water across the gills of a Bull Shark during acoustic tagging in Florida Bay, Everglades National Park\"><img src=\"images/web/fiu-release-sm.jpg\" alt=\"Leaning over a boat to release a fish at sunset\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-backpack.jpg\" data-caption=\"Ghostbuster or aquatic scientist? Backpack electrofishing a small stream in upstate New York\"><img src=\"images/web/ors-backpack-sm.jpg\" alt=\"Backpack electrofishing in a narrow stream\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-blue-crab.jpg\" data-caption=\"Blue Crab collected for stable isotopes in the Shark River, Everglades National Park\"><img src=\"images/web/fiu-blue-crab-sm.jpg\" alt=\"Holding up a blue crab by its claws on a boat\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/ttu-larvae.jpg\" data-caption=\"Larval suckers from Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-larvae-sm.jpg\" alt=\"Three larval suckers seen through a microscope eyepiece\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-gar-night.jpg\" data-caption=\"Do you know why they call it a Longnose Gar? Ohio River near Paducah, KY\"><img src=\"images/web/ors-gar-night-sm.jpg\" alt=\"Mack holding a Longnose Gar at night under a headlamp\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-crocodile.jpg\" data-caption=\"An American Crocodile with a meal at the Flamingo boat ramp\"><img src=\"images/web/fiu-crocodile-sm.jpg\" alt=\"A crocodile holding prey in its jaws at the edge of a boat ramp\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-snook-workup.jpg\" data-caption=\"Acoustic tagging surgery on a Common Snook in Tarpon Bay, Everglades National Park\"><img src=\"images/web/fiu-snook-workup-sm.jpg\" alt=\"Handling a snook in a tub on an electrofishing boat\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ttu-crew.jpg\" data-caption=\"Sucker squad – great team of students and friends that made my MS work possible\"><img src=\"images/web/ttu-crew-sm.jpg\" alt=\"Four people in waders beside a stream\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/fiu-lily-sampling.jpg\" data-caption=\"Sampling the base of the food web in the marsh-mangrove ecotone of the Shark River, Everglades National Park\"><img src=\"images/web/fiu-lily-sampling-sm.jpg\" alt=\"Mack chest-deep in water among lily pads, handing samples to a colleague\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/tu-saw-crew.jpg\" data-caption=\"Stream restoration crew in Monongahela National Forest, WV\"><img src=\"images/web/tu-saw-crew-sm.jpg\" alt=\"Three crew members with chainsaws in the forest\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-shark.jpg\" data-caption=\"A Bull Shark, measured and sampled for stable isotopes in Florida Bay, Everglades National Park\"><img src=\"images/web/fiu-shark-sm.jpg\" alt=\"Mack kneeling on a boat with a shark\" loading=\"lazy\"></button>\n    <button class=\"g-tall\" data-full=\"images/web/osu-catfish-selfie.jpg\" data-caption=\"The cutest kitty on the river – Great Miami River, OH\"><img src=\"images/web/osu-catfish-selfie-sm.jpg\" alt=\"Mack grinning beside a catfish held up to the camera\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/osu-redhorse.jpg\" data-caption=\"Blue Sucker, one of my favorites, in the Scioto River, OH\"><img src=\"images/web/osu-redhorse-sm.jpg\" alt=\"Mack holding a large Blue Sucker beside a river\" loading=\"lazy\" style=\"object-position: 75% 50%\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/osu-gravel-bar.jpg\" data-caption=\"Lunch break on the Scioto River, OH\"><img src=\"images/web/osu-gravel-bar-sm.jpg\" alt=\"View from a boat of a wide muddy river beside a gravel bar\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-seine.jpg\" data-caption=\"Retrieving a seine set from Florida Bay, Everglades National Park\"><img src=\"images/web/fiu-seine-sm.jpg\" alt=\"Crew pulling a seine net with red floats into a boat on open water\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-boat.jpg\" data-caption=\"Winter workin’ on the Ohio River\"><img src=\"images/web/ors-boat-sm.jpg\" alt=\"Driving a sampling boat on a river\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/fiu-camp-night.jpg\" data-caption=\"Late nights at Canepatch, a shell midden deep in the Shark River backcountry of Everglades National Park\"><img src=\"images/web/fiu-camp-night-sm.jpg\" alt=\"Tents glowing under headlamps at night\" loading=\"lazy\"></button>\n    <button class=\"g-wide\" data-full=\"images/web/fiu-snook-release2.jpg\" data-caption=\"Releasing a tagged Common Snook in the Shark River, Everglades National Park\"><img src=\"images/web/fiu-snook-release2-sm.jpg\" alt=\"Reaching over the side of a boat to release a snook\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ttu-sucker-smile.jpg\" data-caption=\"A fish-filled day on Citico Creek, Cherokee National Forest\"><img src=\"images/web/ttu-sucker-smile-sm.jpg\" alt=\"Grinning in a stream with a sucker\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ors-forest-crew.jpg\" data-caption=\"Survey crew in a pristine headwater stream somewhere in Pennsylvania\"><img src=\"images/web/ors-forest-crew-sm.jpg\" alt=\"A survey crew sitting on a log over a rocky stream\" loading=\"lazy\"></button>\n    <button class=\"g-std\" data-full=\"images/web/ttu-overlook.jpg\" data-caption=\"Taking a break from sucker sampling to dig for ramps along the Tennessee-North Carolina line\"><img src=\"images/web/ttu-overlook-sm.jpg\" alt=\"Standing on a grassy overlook above forested hills\" loading=\"lazy\"></button>\n  </div>\n</section>\n\n<dialog class=\"mw-lightbox\" aria-label=\"Photo viewer\">\n  <img alt=\"\">\n  <p class=\"mw-lb-caption\"></p>\n  <button class=\"mw-lb-close\" type=\"button\">Close</button>\n  <button class=\"mw-lb-prev\" type=\"button\" aria-label=\"Previous photo\">&#8249;</button>\n  <button class=\"mw-lb-next\" type=\"button\" aria-label=\"Next photo\">&#8250;</button>\n</dialog>\n\n<!-- ============ PATH ============ -->\n<section class=\"mw-path\" aria-labelledby=\"path-h\">\n  <h2 id=\"path-h\" class=\"mw-h2\">How I got here</h2>\n  <ol>\n    <li><span class=\"yr\">2025 to now</span><span><strong>The Ohio State University</strong>, Postdoctoral Research Scientist</span></li>\n    <li><span class=\"yr\">2021 to 2025</span><span><strong>Florida International University</strong>, Ph.D.</span></li>\n    <li><span class=\"yr\">2019 to 2021</span><span><strong>Tennessee Technological University</strong>, M.S.</span></li>\n    <li><span class=\"yr\">2018</span><span><strong>ORSANCO</strong>, Contractual Biologist</span></li>\n    <li><span class=\"yr\">2017</span><span><strong>Trout Unlimited &amp; US Forest Service</strong>, Watershed Restoration Technician</span></li>\n    <li><span class=\"yr\">2013 to 2017</span><span><strong>Marshall University</strong>, B.S.</span></li>\n  </ol>\n</section>\n\n<!-- ============ CONTACT ============ -->\n<section class=\"mw-contact\">\n  <p>Want to collaborate or have questions?</p>\n  <a class=\"mw-contact-mail\" href=\"mailto:mackwhiteecology@gmail.com\">mackwhiteecology@gmail.com</a>\n</section>\n\n<script>\n(function () {\n  // Hero video: pause control, and respect reduced-motion settings\n  var v = document.querySelector('.mw-hero-video');\n  var btn = document.querySelector('.mw-video-toggle');\n  function setPlaying(on) {\n    if (on) { v.play().catch(function(){}); } else { v.pause(); }\n    btn.textContent = on ? 'Pause video' : 'Play video';\n    btn.setAttribute('aria-pressed', on ? 'false' : 'true');\n  }\n  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); setPlaying(false); }\n  btn.addEventListener('click', function () { setPlaying(v.paused); });\n  // Hide the toggle if the video file isn't there yet\n  var foot = document.querySelector('.mw-hero-foot');\n  var src = v.querySelector('source');\n  if (src) src.addEventListener('error', function () { foot.hidden = true; });\n\n  // Navbar goes solid once you scroll past the hero\n  var hero = document.querySelector('.mw-hero');\n  function onScroll() { document.body.classList.toggle('mw-scrolled', window.scrollY > hero.offsetHeight - 80); }\n  window.addEventListener('scroll', onScroll, { passive: true }); onScroll();\n\n  // Lightbox\n  var items = Array.prototype.slice.call(document.querySelectorAll('.mw-gallery button'));\n  var dlg = document.querySelector('.mw-lightbox');\n  var img = dlg.querySelector('img'), cap = dlg.querySelector('.mw-lb-caption');\n  var idx = 0;\n  function show(i) {\n    idx = (i + items.length) % items.length;\n    var b = items[idx];\n    img.src = b.dataset.full; img.alt = b.querySelector('img').alt; cap.textContent = b.dataset.caption || '';\n  }\n  items.forEach(function (b, i) { b.addEventListener('click', function () { show(i); dlg.showModal(); }); });\n  dlg.querySelector('.mw-lb-close').addEventListener('click', function () { dlg.close(); });\n  dlg.querySelector('.mw-lb-prev').addEventListener('click', function () { show(idx - 1); });\n  dlg.querySelector('.mw-lb-next').addEventListener('click', function () { show(idx + 1); });\n  dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });\n  dlg.addEventListener('keydown', function (e) {\n    if (e.key === 'ArrowLeft') show(idx - 1);\n    if (e.key === 'ArrowRight') show(idx + 1);\n  });\n})();\n</script>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-